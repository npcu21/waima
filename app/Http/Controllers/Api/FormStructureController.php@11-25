    /**
     * GET /api/forms/{seed_id}
     * Returns form structure based on seed_id
     */
    public function getFormBySeed($seed_id)
    {
        // Seed ID के हिसाब से form choose करना
        switch ($seed_id) {
            case 1: // Veterinary Products
                $form = $this->veterinaryProductsForm($seed_id);
                $form_type = "veterinary-products";
                break;
            case 2: // Animal Feed
                $form = $this->feedForm($seed_id);
                $form_type = "feed-form";
                break;
            case 3: // Synthetic Pesticides
                $form = $this->syntheticPesticidesForm($seed_id);
                $form_type = "synthetic-pesticides";
                break;
            case 4: // Inorganic Soil Conditioners
                $form = $this->inorganicSoilConditionersForm($seed_id);
                $form_type = "inorganic-soil-conditioners";
                break;
            case 5: // Biostimulants
                $form = $this->biostimulantsForm($seed_id);
                $form_type = "biostimulants";
                break;
            case 6: // Organic Amendments
                $form = $this->organicAmendments($seed_id);
                $form_type = "organic-amendments";
                break;
            case 7: // Mineral Fertilizers
                $form = $this->fertilizerForm($seed_id);
                $form_type = "fertilizer-form";
                break;
            case 8: // Seeds
                $form = $this->seedDetailsForm($seed_id);
                $form_type = "seed-details";
                break;
            default:
                return response()->json([
                    "success" => false,
                    "message" => "Form not found for seed_id $seed_id"
                ], 404);
        }

        return response()->json([
            "success" => true,
            "seed_id" => $seed_id,
            "form_type" => $form_type,
            "data" => $form
        ]);
    }

