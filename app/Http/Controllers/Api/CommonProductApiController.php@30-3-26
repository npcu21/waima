            $qrDir . '/' . $qrName,
            'L',
            4,
            2
        );

        $bio->qr_code_path = 'qrcodes/' . $qrName;
        $bio->save();

        // ================= NOTIFICATION =================
        \DB::table('notifications')->insert([
            'title'       => empty($validated['id']) ? 'New Bio Stimulant Created' : 'Bio Stimulant Update Pending',
            'message'     => 'Product: ' . $bio->trade_name,
            'user_id'     => $validated['created_by'],
            'related_id'  => $bio->id,
            'type'        => 'bio_stimulant',
            'status'      => 0, // unread
            'created_at'  => now(),
            'updated_at'  => now(),
        ]);

        \DB::commit();

        return response()->json([
            'status'  => true,
            'message' => empty($validated['id'])
                ? 'Bio Stimulant created (Pending)'
                : 'Bio Stimulant update sent for approval (Pending)',
            'data' => $bio
        ], empty($validated['id']) ? 201 : 200);

    } catch (\Exception $e) {
        \DB::rollBack();

        return response()->json([
            'status'  => false,
            'message' => 'Failed to save Bio Stimulant',
            'error'   => $e->getMessage()
        ], 500);
    }
