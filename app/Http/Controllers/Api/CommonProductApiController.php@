        'semiwholesalePrice' => 'nullable|numeric',
        'retailPrice' => 'nullable|numeric',
        'supplier_id' => 'nullable|integer',
        'agent_id' => 'nullable|integer',
        'created_by' => 'nullable|integer',
        'status_id' => 'nullable|integer',
        'image' => 'nullable|image|mimes:jpeg,png,jpg,webp|max:2048',
        'otherRecommendationsPhoto' => 'nullable',
    ]);

    // ----------------- DEFAULT VALUES -----------------
    // $validated['status_id'] = $request->input('status_id', 1);
    $validated['agent_id'] = $request->input('agent_id', 1);
    $validated['language_id'] = 1;
    $validated['form_type'] = 'seed_form';
    $validated['InherentNutritionalValue'] = json_encode($validated['InherentNutritionalValue'] ?? []);
    $validated['product_id'] = $request->input('product_id');
    $userId = $request->input('created_by', Auth::id() ?? 1);
    

    if ($request->filled('supplier_id')) {
    // Supplier आया → Status 1
    $validated['status_id'] = 1;
} elseif ($request->filled('agent_id') && !$request->filled('supplier_id')) {
    // Sirf Agent आया → Status 4
    $validated['status_id'] = 4;
} else {
    $validated['status_id'] = 1; // Default
}

    // ----------------- UPDATE MODE -----------------
    if ($id) {
        $seedForm = SeedForm::find($id);

        if (!$seedForm) {
            return response()->json([
                'status' => false,
                'message' => 'Seed form not found.'
            ], 404);
        }

        // ⭐ Store old prices in price_histories
        \DB::table('price_histories')->insert([
            'product_id'         => $seedForm->product_id,
            'supplier_id'        => $seedForm->supplier_id,
            'wholesalePrice'     => $seedForm->wholesalePrice,
            'semiwholesalePrice' => $seedForm->semiwholesalePrice,
            'retailPrice'        => $seedForm->retailPrice,
            'updated_by'         => $userId,
            'add_product_id'     => $seedForm->id,
            'changed_at'         => now(),
            'created_at'         => now(),
            'updated_at'         => now(),
        ]);

        // Update main table
        $seedForm->update($validated);

        $message = 'Seed form updated successfully, price history saved.';
    } else {
        // ----------------- CREATE MODE -----------------
        $seedForm = SeedForm::create($validated);
        Notification::create([
    'title'   => 'New Product Added',
    'message' => "Add porduct {$request->cropName} - {$request->verityName} has been added.",
    'is_read' => 0,
]);

        // ⭐ First price log
        \DB::table('price_histories')->insert([
            'product_id'         => $seedForm->product_id,
            'supplier_id'        => $seedForm->supplier_id,
            'wholesalePrice'     => $seedForm->wholesalePrice,
            'semiwholesalePrice' => $seedForm->semiwholesalePrice,
            'retailPrice'        => $seedForm->retailPrice,
            'updated_by'         => $userId,
            'add_product_id'     => $seedForm->id,
            'changed_at'         => now(),
            'created_at'         => now(),
            'updated_at'         => now(),
        ]);

        $message = 'Seed form created successfully, price history saved.';
    }

    // ----------------- QR CODE GENERATION -----------------
    include_once(public_path('phpqrcode/qrlib.php'));
    $qrFolder = public_path('qrcodes');
    if (!file_exists($qrFolder)) mkdir($qrFolder, 0755, true);

    $qrFileName = 'seedform_' . $seedForm->id . '.png';
    \QRcode::png(url('/seed-form/' . $seedForm->id), $qrFolder . '/' . $qrFileName, 'L', 4, 2);

    $seedForm->qr_code_path = 'qrcodes/' . $qrFileName;
    $seedForm->save();

    return response()->json([
        'status' => true,
        'message' => $message,
        'data' => $seedForm
    ], $id ? 200 : 201);
}

