                'changed_at'         => now(),
                'created_at'         => now(),
                'updated_at'         => now(),
            ]);

            // -------- NEW PENDING RECORD --------
            $newBioData = collect($validated)
                ->except(['id', 'otherRecommendationsPhoto'])
                ->toArray();
            $newBioData['parent_id'] = $parentBio->id;

            $bio = BioStimulant::create($newBioData);

