private function storeInorganicSoilConditioner(Request $request)
{
    // Map Postman keys to DB
    if ($request->has('semi_wholesale_price')) {
        $request->merge(['semiwholesale_price' => $request->input('semi_wholesale_price')]);
    }
    if ($request->has('other_raw_material')) {
        $request->merge(['other' => $request->input('other_raw_material')]);
    }

    // Validate
    $validated = $request->validate([
        'id' => 'nullable|integer',
        'product_id' => 'nullable|integer',
        'conditioner_type' => 'required|string|max:255',
        'physical_form' => 'required|string|max:50',
        'trade_name' => 'required|string|max:255',
        'raw_material' => 'nullable|string|max:255',
        'other' => 'nullable|string|max:255',
        'function' => 'nullable|string|max:255',
        'wholesale_price' => 'required|numeric',
        'semiwholesale_price' => 'required|numeric',
        'retail_price' => 'required|numeric',
        'supplier_id' => 'nullable|integer|exists:suppliers,id',
        'agent_id' => 'nullable|integer|exists:agents,id',
        'status_id' => 'nullable|integer',
    ]);

    $validated['created_by'] = Auth::id() ?? 1;
    $validated['form_type'] = 'inorganic_soil_conditioner';
    // $validated['status_id'] = $request->input('status_id', 1);
    $validated['agent_id'] = $request->input('agent_id', 1);

     if ($request->filled('supplier_id')) {
    // Supplier आया → Status 1
    $validated['status_id'] = 1;
} elseif ($request->filled('agent_id') && !$request->filled('supplier_id')) {
    // Sirf Agent आया → Status 4
    $validated['status_id'] = 4;
} else {
    $validated['status_id'] = 1; // Default
}


    if ($request->filled('id')) {
        // UPDATE CASE
        $conditioner = InorganicSoilConditioner::find($request->id);
        if (!$conditioner) {
            return response()->json([
                "status" => false,
                "message" => "Record not found for update."
            ], 404);
        }

        // 🔹 Save old prices to price_histories
        \DB::table('price_histories')->insert([
            'product_id' => $conditioner->product_id,
            'supplier_id' => $conditioner->supplier_id,
            'wholesalePrice' => $conditioner->wholesale_price,
            'semiwholesalePrice' => $conditioner->semiwholesale_price,
            'retailPrice' => $conditioner->retail_price,
            'updated_by' => $validated['created_by'],
            'add_product_id' => $conditioner->id,
            'changed_at' => now(),
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        $conditioner->update($validated);

    } else {
        // CREATE CASE
        $conditioner = InorganicSoilConditioner::create($validated);
           Notification::create([
            'title'   => 'New Inorganic Soil Conditioner Added',
            'message' => "Product {$request->trade_name} has been added.",
            'is_read' => 0,
        ]);

        // 🔹 Save initial prices to price_histories
        \DB::table('price_histories')->insert([
            'product_id' => $conditioner->product_id,
            'supplier_id' => $conditioner->supplier_id,
            'wholesalePrice' => $conditioner->wholesale_price,
            'semiwholesalePrice' => $conditioner->semiwholesale_price,
            'retailPrice' => $conditioner->retail_price,
            'updated_by' => $validated['created_by'],
            'add_product_id' => $conditioner->id,
            'changed_at' => now(),
            'created_at' => now(),
            'updated_at' => now(),
        ]);
    }

    // QR Code generation
    include_once(public_path('phpqrcode/qrlib.php'));
    $path = public_path('qrcodes');
    if (!file_exists($path)) mkdir($path, 0755, true);
    $file = 'inorganic_' . $conditioner->id . '.png';
    \QRcode::png(url('/inorganic-soil-conditioner/' . $conditioner->id), $path . '/' . $file, 'L', 4, 2);

    $conditioner->qr_code_path = 'qrcodes/' . $file;
    $conditioner->save();

    // Modify response keys
    $response = $conditioner->toArray();
    $response['semi_wholesale_price'] = $response['semiwholesale_price'];
    $response['other_raw_material'] = $response['other'];
    unset($response['semiwholesale_price'], $response['other']);

    return response()->json([
        "status" => true,
        "message" => $request->filled('id')
            ? "Inorganic Soil Conditioner updated successfully"
            : "Inorganic Soil Conditioner saved successfully",
        "data" => $response
    ]);
}

