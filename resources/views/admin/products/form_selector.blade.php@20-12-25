<script>
document.addEventListener('DOMContentLoaded', () => {

    const supplierSelect = document.getElementById('supplier_select');
    const agentSelect    = document.getElementById('agent_select');
    const productSelect  = document.getElementById('form_select');

    const countryMain = document.getElementById('country_select');
    const countryBox  = document.getElementById('country_list_box');
    const countryList = document.getElementById('country_list');

    const dynamicForm = document.getElementById('dynamicForm');

    loadSuppliers();
    loadAgents();

    /* ================= COUNTRY ================= */
    countryMain.addEventListener('change', function () {
        if (this.value === 'country') {
            countryBox.style.display = 'block';

            fetch('{{ url("get-countries") }}')
                .then(res => res.json())
                .then(data => {
                    countryList.innerHTML = '<option value="">-- Select Country --</option>';
                    data.forEach(c => {
                        countryList.innerHTML += `<option value="${c.id}">${c.name}</option>`;
                    });
                });

        } else {
            countryBox.style.display = 'none';
            loadSuppliers();
            loadAgents();
        }
    });

    countryList.addEventListener('change', function () {
        loadSuppliers(this.value);
        loadAgents(this.value);
    });

    function loadSuppliers(countryId = '') {
        let url = '{{ url("products/get-suppliers") }}';
        if (countryId) url += '?country_id=' + countryId;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                supplierSelect.innerHTML = '<option value="">-- Select Supplier --</option>';
                data.forEach(s => {
                    supplierSelect.innerHTML += `<option value="${s.id}">${s.company_name}</option>`;
                });
            });
    }

    function loadAgents(countryId = '') {
        let url = '{{ url("products/get-agents") }}';
        if (countryId) url += '?country_id=' + countryId;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                agentSelect.innerHTML = '<option value="">-- Select Agent --</option>';
                data.forEach(a => {
                    agentSelect.innerHTML += `<option value="${a.id}">${a.name}</option>`;
                });
            });
    }

    /* ================= PRODUCT → FORM API ================= */
    productSelect.addEventListener('change', function () {

        const productId = this.value;
        dynamicForm.innerHTML = '';

        document.getElementById('hidden_product_id').value = productId;
        document.getElementById('form_product_id').value   = productId;

        if (!productId) return;

        fetch(`{{ url('api/forms') }}/${productId}`)
            .then(res => res.json())
            .then(res => {

                if (!res.success || !Array.isArray(res.data)) {
                    dynamicForm.innerHTML = '<p class="text-danger">No fields found</p>';
                    return;
                }

                let html = '';

                res.data.forEach(field => {

                    /* hidden fields */
                    if (field.inputType === 'hidden') {
                        html += `<input type="hidden" name="${field.key}" value="">`;
                        return;
                    }

                    html += `
                    <div class="col-md-4 mb-3">
                        <label class="form-label">${field.label}</label>
                    `;

                    /* TEXT / NUMBER / DATE */
                    if (['text','number','date'].includes(field.inputType)) {
                        html += `
                        <input type="${field.inputType}"
                               name="${field.key}"
                               class="form-control"
                               ${field.required ? 'required' : ''}>
                        `;
                    }

                    /* FILE */
                    if (field.inputType === 'file') {
                        html += `
                        <input type="file"
                               name="${field.key}"
                               class="form-control"
                               ${field.required ? 'required' : ''}>
                        `;
                    }

                    /* RADIO */
                    if (field.inputType === 'radio') {
                        field.options.forEach(opt => {
                            html += `
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="${field.key}"
                                       value="${opt}">
                                <label class="form-check-label">${opt}</label>
                            </div>
                            `;
                        });
                    }

                    /* SELECT (future use) */
                    if (field.inputType === 'select') {
                        html += `<select name="${field.key}" class="form-control">
                                    <option value="">-- Select --</option>`;
                        field.options.forEach(opt => {
                            html += `<option value="${opt}">${opt}</option>`;
                        });
                        html += `</select>`;
                    }

                    html += `</div>`;
                });

                dynamicForm.innerHTML = html;
                syncIds(); // supplier & agent sync
            })
            .catch(err => {
                console.error(err);
                dynamicForm.innerHTML = '<p class="text-danger">API Error</p>';
            });
    });

    /* ================= SYNC SUPPLIER + AGENT ================= */
    function syncIds() {
        document.querySelectorAll('input[name="supplier_id"]').forEach(el => {
            el.value = supplierSelect.value;
        });
        document.querySelectorAll('input[name="agent_id"]').forEach(el => {
            el.value = agentSelect.value;
        });
    }

    supplierSelect.addEventListener('change', syncIds);
    agentSelect.addEventListener('change', syncIds);

});
</script>


