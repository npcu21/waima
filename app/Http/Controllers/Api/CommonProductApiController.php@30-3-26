            'otherRecommendationsPhoto' => 'nullable|image|mimes:jpg,jpeg,png,webp|max:2048',
        ]);

        // ======================================================
        // DEFAULT VALUES
        // ======================================================
        $validated['agent_id']    = $request->input('agent_id', 1);
        $validated['language_id'] = 1;
        $validated['form_type']   = 'animal_feed';
