        'precocity' => 'nullable|string|max:255',
        'fruitColor' => 'nullable|string|max:255',
        'fruitShape' => 'nullable|string|max:255',
        'leafLength' => 'nullable|string|max:255',
        'leafColor' => 'nullable|string|max:255',
